{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7147"
    ]
  },
  "Jwt": {
    "Issuer": "StepByStepCoding",
    "Audience": "StepByStepCoding",
    "AccessTokenLifeTime": 15,
    "RefreshTokenLifeTime": 10080
  },
  "CookieKeys": {
    "AccessToken": "access_token",
    "RefreshToken": "refresh_token"
  },
  "Redis": {
    "DefaultAbsoluteExpiration": "12:00:00",
    "DefaultSlidingExpiration": "02:00:00",
    "KeyPrefix": "StepByStepCoding:"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "CodeExecution": {
    "BaseUrl": "http://piston:2000/",
    "CppVersion": "10.2.0",
    "PythonVersion": "3.10.0",
    "JavaVersion": "15.0.2",
    "CompileTimeoutMilliseconds": 10000,
    "RunTimeoutMilliseconds": 3000,
    "CompileMemoryLimitBytes": 536870912,
    "RunMemoryLimitBytes": 268435456,
    "JavaRunMemoryLimitBytes": 536870912,
    "HttpTimeoutSeconds": 25
  }
}
