# Log in using Auth.http first; these requests use the HTTP client cookie jar.
@host = https://localhost:7147
@id = 00000000-0000-0000-0000-000000000001
@version = 00000000-0000-0000-0000-000000000002

### List
GET {{host}}/api/examattempts?page=1&recordsPerPage=20

### Detail
GET {{host}}/api/examattempts/{{id}}

### StartExamAttempt
POST {{host}}/api/examattempts
Content-Type: application/json

{
  "examId": "{{id}}"
}

### FinishExamAttempt
POST {{host}}/api/examattempts/{{id}}/finish
Content-Type: application/json

{
  "version": "{{version}}"
}
